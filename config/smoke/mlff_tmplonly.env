# SMOKE -- scorer B (MLFF) on the EXISTING templated-pool MM-GBSA scores (the tmplonly candidate
# set), top-2 per ligand, then a SCORER=mlff select; everything written under scratch (GBSA_DIR,
# SUB_DIR). Pass = 40 Orb rows, mlff_score for all 20 ligands, a valid 20/20 zip, and members that
# differ from submission_mol1_tmplonly_mmgbsa only where merge_eint reports a moved pick.
GBSA_DIR=$SCRATCH/cofolder_smoke/gbsa
POOL=smoke_tmplonly
CKPT_LABEL=mol1
SCORED=$ROOT/data/cyp3a4_ob0_mmgbsa/scored_mol1_tmpl.csv
RANK_POOLS="mol1_tcryo5 mol1_t38FX mol1_tcomb4"
MLFF_TOPK=2
MLFF_SHARDS=4
SCORER=mlff
NAME=smoke_tmplonly_mlff
REFS=$GEN_DIR/submission/submission_mol1_tmplonly_mmgbsa.zip
SUB_DIR=$SCRATCH/cofolder_smoke/submission
