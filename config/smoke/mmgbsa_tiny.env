# SMOKE -- scorer A (MM-GBSA) end to end on TWO existing mol1_tcomb4 poses: fresh build + score
# under a scratch SCRATCH, merge with the CKPT_LABEL attribution. Needs the 2-row poselist
# $GBSA_DIR/poselist_smoke_gbsa2.csv (header + 2 rows of poselist_mol1tmpl.csv). Pass = 2 status=ok
# rows whose delta_total matches scored_mol1_tmpl.csv for the same pose_ids.
SCRATCH=$SCRATCH/cofolder_smoke/scratch
GBSA_DIR=/scratch-shared/20255165/cofolder_smoke/gbsa
POOL=mol1_tcomb4
CKPT_LABEL=mol1
SET=smoke_gbsa2
MLFF_TOPK=0
