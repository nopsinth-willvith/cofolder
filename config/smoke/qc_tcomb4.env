# SMOKE -- stage 2b (QC) on the EXISTING mol1_tcomb4 poses, writing only to scratch: the scratch
# GEN_DIR holds gen/mol1_tcomb4 as a symlink to the real pool. Pass = pb_pass per pose identical to
# data/cyp3a4_mol1/poses_qc_mol1_tcomb4.csv, and a 930-row poselist.
GEN_DIR=$SCRATCH/cofolder_smoke/gen_dir
GBSA_DIR=$SCRATCH/cofolder_smoke/gbsa
POOL=mol1_tcomb4
CKPT_LABEL=mol1
TEMPLATE_MODE=bundle
TEMPLATE_BUNDLE=$ROOT/data/cyp3a4_mol1/templates/comb4.json
