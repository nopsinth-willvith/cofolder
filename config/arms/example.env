# config/arms/example.env -- ONE ARM = one pose pool + its scores + its submission.
# Copy this file to config/arms/<arm>.env, set POOL + CKPT_LABEL + the stage-1 block, then:
#     slurm/run.sh template config/arms/<arm>.env     # 1 template selector   (CPU, ~10 min)
#     slurm/run.sh cofold   config/arms/<arm>.env     # 2 co-folding + QC     (GPU, ~3 h)
#     slurm/run.sh rerank   config/arms/<arm>.env     # 3 MM-GBSA -> MLFF     (CPU, ~200 CPU-h)
#     slurm/run.sh select   config/arms/<arm>.env     # 3 pick + zip + audit  (CPU, ~20 min)
#     slurm/run.sh status   config/arms/<arm>.env     # what exists / is queued
# Every knob not set here takes the default shown (= the measured reference configuration).
# Bash syntax; sourced inside each job, so commas are safe. Paths from config/cluster.env
# ($ROOT, $GEN_DIR, $GBSA_DIR, $MOL1, ...) are available.

# ==== identity =============================================================================
POOL=mol1_example           # [A-Za-z0-9_], NEW per arm; names gen/<POOL>, poses_qc_<POOL>.csv
CKPT_LABEL=mol1             # checkpoint the merged tables attribute every pick to. Stock weights keep
                            # `mol1`; a changed SAMPLER earns its own label (TFG => mol1+tfg); a
                            # fine-tune gets its own (mol1ft). Required.
# SET=$POOL                 # MM-GBSA shard family (poselist_<SET>, mmgbsa_<SET>_shard*, scored_<SET>)
# SET_POOLS=$POOL           # every pool sharing that SET, so QC builds poselist_<SET> from ALL of
                            # their QC tables (the last pool QC'd writes it) instead of rewriting it
                            # from whichever arm finished last. Must include POOL.
# SCORED=$GBSA_DIR/scored_$SET.csv   # point at an EXISTING merged table to run only mlff/select

# ==== STAGE 1: template selector ===========================================================
TEMPLATE_MODE=fixed         # none | bundle | fixed | similarity
# bundle:      TEMPLATE_BUNDLE=$GEN_DIR/templates/comb4.json     (reuse an existing bundle JSON)
# fixed:       entries in RANK ORDER -- Mol-1 keeps the first 4, unsorted
TEMPLATE_IDS="5VCC 6MA8 6MA6 6BCZ"
TEMPLATE_CIF_DIR=$ROOT/data/cyp_structure_track/cif
# similarity:  per-ligand top-4 distinct co-crystal ligands by ECFP4 (TEMPLATE_CIF_DIR as above)
# TEMPLATE_CHAIN=A
# EXPECT_TEMPLATES=4        # the gate FAILS unless exactly this many reach the features
# EXPECT_COVERAGE="457 463 466 461"   # optional per-template residue floor (shared bundles only)
# GATE_ALL=auto             # auto: every ligand for `similarity`, the first input otherwise
# FE_BOND_TABLE=            # CSV base_id,donor_atom -> declared HEM:FE covalent bond (off-distribution;
                            # measured to OVER-contract to 1.78-1.96 A -- never template-free)
# MSA_A3M=$DEFAULT_MSA_A3M

# ==== STAGE 2: co-folding (Mol-1) ===========================================================
# CKPT=$MOL1/data/checkpoint/mol-1-base.pt
# SEEDS=101,102,103,104,105,106,107,108,109,110
# N_SAMPLE=5  N_STEP=200  N_CYCLE=20        # 10 seeds x 5 samples = 50 poses/ligand
# MSA_MIN=16384  MSA_CUT=16384              # = full depth per recycle; set BOTH empty for Mol-1's
                                            # stochastic default (not a full-MSA arm)
# GUIDANCE=0                                # 1 = TFG chemistry guidance (needs the mol1_tfg port)
# TFG_MU=  TFG_INNER=
# CHUNK_SIZE=2                              # ligands/task; >2 OOMs a 22 GiB L4 with tmpl + full MSA
# GEN_TIME=03:30:00  GEN_MEM=20G  GEN_THROTTLE=6     # GUIDANCE=1 defaults GEN_TIME to 12:00:00

# ==== STAGE 3: physics re-ranking ===========================================================
# PREP_PH=7.4  HEM_PROTONATION=propionate   # both scorers; a pH variant needs its own SET
# -- scorer A: MM-GBSA on every pb_pass pose (~12 CPU-min/pose -> ~200 CPU-h per 1000 poses)
# POSES_PER_SHARD=10  GBSA_THROTTLE=60
# -- scorer B: MLFF E_int (Orb orbmol_v2) on the MM-GBSA top-K per ligand, AS CO-FOLDED (no
#    relaxation); 0 disables. ~70 CPU-s/pose. Ranks E_int_conserving, 20 eV/A force-gated.
# MLFF_TOPK=3  MLFF_MODEL=orbmol_v2  MLFF_SHARDS=6

# -- selection (slurm/run.sh select)
# SELECT_MODE=rank          # rank | classmix | override | audit
# SCORER=mmgbsa             # rank by: mmgbsa (delta_total) | mlff (mlff_score from eint_<POOL>.csv)
# RANK_SCORES=              # tables competing; default = $SCORED (mmgbsa) or $GBSA_DIR/eint_$POOL.csv
                            # (mlff). Several pools: RANK_SCORES="$GBSA_DIR/scored_a.csv $GBSA_DIR/scored_b.csv"
# RANK_POOLS=$POOL          # pools allowed to compete (space-separated), or `all`
# FE_IN=2.6  FE_RETAIN=3.5  FE_LADDER=3.0:4.0,3.5:4.5   # Type-II Fe gate (in / after minimisation)
# PB_TOPK=5                 # PoseBusters fallback depth down the ranking
# ADD_REPAIRED=0            # 1 = append the repaired OCNT-2313038 rows (pool mol1_repair); mmgbsa only
# NAME=submission_${POOL}_${SCORER}
# SUB_DIR=$GEN_DIR/submission
# REFS="$GEN_DIR/submission/submission_mol1_tmpl_mmgbsa.zip"   # zips to diff against; empty = none
# classmix: TYPEII_FROM=<zip basename>  NONTYPEII_FROM=<zip basename>   (both in SUB_DIR)
# override: BASE_ZIP=<zip basename>  ALT_ZIP=<zip basename>  FROM_ALT="OCNT-... OCNT-..."
