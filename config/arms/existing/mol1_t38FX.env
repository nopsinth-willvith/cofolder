# EXISTING POOL mol1_t38FX -- the configuration it was generated with, as a record and for re-ranking.
# gen/mol1_t38FX already holds poses, so 'template' and 'cofold' REFUSE (the unmixed-pool guard), and
# SCORED points at the existing merged table, so 'rerank' refuses too. Use: status | mlff | select.
# To re-run this configuration, copy it to config/arms/<new>.env with a NEW POOL and drop SET/SCORED.
POOL=mol1_t38FX
CKPT_LABEL=mol1
TEMPLATE_MODE=bundle                      # the single azamulin cryo-EM structure
TEMPLATE_BUNDLE=$GEN_DIR/templates/38FX.json
SET=mol1tmpl                              # one shard family for mol1_tcryo5 + mol1_t38FX + mol1_tcomb4
SET_POOLS="mol1_tcryo5 mol1_t38FX mol1_tcomb4"   # so QC builds poselist_mol1tmpl from all three
SCORED=$GBSA_DIR/scored_mol1_tmpl.csv    # those three + mol1_full; RANK_POOLS keeps this pool only
