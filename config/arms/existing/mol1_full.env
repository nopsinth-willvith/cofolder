# EXISTING POOL mol1_full -- the configuration it was generated with, as a record and for re-ranking.
# gen/mol1_full already holds poses, so 'template' and 'cofold' REFUSE (the unmixed-pool guard), and
# SCORED points at the existing merged table, so 'rerank' refuses too. Use: status | mlff | select.
# To re-run this configuration, copy it to config/arms/<new>.env with a NEW POOL and drop SET/SCORED.
POOL=mol1_full
CKPT_LABEL=mol1
TEMPLATE_MODE=none                        # template-free, full MSA (16384/16384), seeds 101-110 x 5
SET=mol1full
SCORED=$GBSA_DIR/scored_mol1_mmgbsa.csv   # 845 pb_pass poses, mol1_full only
