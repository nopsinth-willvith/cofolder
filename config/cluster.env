# config/cluster.env -- WHERE things are. Edit once per cluster; every stage sources it.
# Bash syntax, sourced by slurm/lib.sh (never passed through sbatch --export, so commas are safe).

# ---- campaign root: inputs, reference tables, data dirs ------------------------------------
ROOT=/vast.mnt/project/bme-20255165-cofolding-physics
BLINDED_CSV=$ROOT/cyp-challenge-structure/cyp-challenge-TEST-BLINDED_structures.csv
TYPEII_LIST=$ROOT/data/cyp3a4_xmodel/typeii_base_ids.txt          # the 11 Fe-coordinating ligands
DEFAULT_MSA_A3M=$ROOT/data/cyp_structure_track/of3_msa/CYP3A4_P08684_full/colabfold_main.a3m

# ---- where stages write. Defaults = the campaign's existing dirs, so a new arm competes
# ---- directly with every pool already generated and scored there.
GEN_DIR=$ROOT/data/cyp3a4_mol1            # inputs_<POOL>/ templates/ gen/ poses/ poses_qc_<POOL>.csv submission/
GBSA_DIR=$ROOT/data/cyp3a4_ob0_mmgbsa     # poselist_<SET> mmgbsa_<SET>_shard* scored_<SET> | mlff_<POOL>/ eint_<POOL>.csv
SCRATCH=/scratch-shared/20255165          # MM-GBSA systems / MLFF prep npz (big, regenerable)

# ---- the co-folding model: VENDORED in this repo at mol1/ (see mol1/VENDORED.md) ----------
# mol1/ holds the inference code with the TFG guidance port already in it, so an arm runs this
# repo's model, not a checkout elsewhere. Only the two things too large to vendor stay outside:
MOL1=$COFOLDER/mol1
# MOL_ROOT_DIR: the CCD caches (659 MB, mandatory) and the 2.3 GB checkpoint. The template route
# also WRITES downloaded mmCIFs into $MOL1_DATA/mmcif, so this path must be writable.
MOL1_DATA=/project/bme-20255165-foldx/Mol-1/data
# Any interpreter carrying mol1/'s dependencies. VENDORED.md lists the exact installed versions
# (requirements.txt does NOT match them) and the editable-install trap that mol1_env guards.
MOL1_PY=/project/bme-20255165-foldx/Mol-1/.venv/bin/python

# ---- environments (absolute prefixes; `conda activate` does not work inside sbatch) --------
CONDA_ENVS=$ROOT/miniforge3/envs
ENV_QC=$CONDA_ENVS/sigmadock       # PoseBusters 0.6.5 + pandas: QC, selection, merges
ENV_AMBER=$CONDA_ENVS/openmm83     # AmberTools/OpenMM: MM-GBSA build + score, MLFF prep
ENV_VALID=$CONDA_ENVS/biokinema    # the challenge's official zip validator
ENV_OST=$CONDA_ENVS/plinder        # the only env with a real openstructure (lDDT-PLI diffs)
ENV_KALIGN=$CONDA_ENVS/kalign      # Mol-1 asserts kalign on PATH whenever templates are on
ENV_MLFF=$CONDA_ENVS/orb-env       # Orb (orbmol_v2) for E_int (stdlib csv only: no pandas here)

# ---- Slurm ------------------------------------------------------------------------------
CPU_PARTITION=tue.cpu1.q,tue.cpu2.q,tue.cpu3.q
# tue.gpu2.q must be ABSENT (its only node is the broken tue-gpub001): naming it beside the
# exclude leaves zero eligible nodes and the array parks at BadConstraints forever.
GPU_PARTITION=bme.gpumolml.q,bme.gpu2.q,tue.gpu3.q,tue.gpu.q
GPU_EXCLUDE=tue-gpua001,tue-gpub001
